<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="application\Features\" />
      <Folder Include="application\Interfaces\" />
      <Folder Include="domain\Exceptions\" />
      <Folder Include="domain\Repositories\" />
      <Folder Include="infrastructure\Authentication\JWT\" />
      <Folder Include="infrastructure\Authentication\OAuth\" />
      <Folder Include="infrastructure\Caching\" />
      <Folder Include="infrastructure\Mail\" />
      <Folder Include="infrastructure\Persistence\Migrations\" />
      <Folder Include="infrastructure\Repositories\" />
      <Folder Include="infrastructure\Storage\S3\" />
      <Folder Include="presentation\Controllers\" />
      <Folder Include="presentation\Middleware\" />
    </ItemGroup>

</Project>
