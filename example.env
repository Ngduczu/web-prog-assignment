# Tên database PostgreSQL dùng cho container Docker.
POSTGRES_DB=
# Tên user PostgreSQL dùng cho container Docker.
POSTGRES_USER=
# Mật khẩu PostgreSQL dùng cho container Docker.
POSTGRES_PASSWORD=
# Port PostgreSQL expose ra máy host.
POSTGRES_PORT=

# Port Redis expose ra máy host.
REDIS_PORT=

# Connection string PostgreSQL cho ASP.NET Core; cần quote vì có dấu chấm phẩy.
CONNECTIONSTRINGS__DEFAULTCONNECTION="Host=localhost;Port=5433;Database=your_database;Username=your_user;Password=your_password"
# Connection string Redis cho ASP.NET Core.
CONNECTIONSTRINGS__REDIS="localhost:6379,abortConnect=false"

# Host SMTP dùng để gửi email xác thực và reset password.
MAIL__HOST=smtp.gmail.com
# Port SMTP, thường dùng 587 cho STARTTLS.
MAIL__PORT=587
# Bật SSL/TLS cho kết nối SMTP.
MAIL__ENABLESSL=true
# Tài khoản SMTP/Gmail dùng để gửi email.
MAIL__USERNAME=your-smtp-username
# App password SMTP, không dùng mật khẩu Gmail chính.
MAIL__PASSWORD=your-smtp-app-password
# Địa chỉ email hiển thị ở trường From.
MAIL__FROMEMAIL=your-sender@example.com
# Tên hiển thị của người gửi.
MAIL__FROMNAME=LMS

# Issuer ghi vào JWT.
JWT__ISSUER=LMS.Api
# Audience hợp lệ của JWT.
JWT__AUDIENCE=LMS.Client
# Signing key JWT tối thiểu 32 bytes; phải thay bằng secret ngẫu nhiên.
JWT__SIGNINGKEY=replace-with-a-random-secret-at-least-32-bytes
# Thời gian sống access token, tính theo phút.
JWT__EXPIRATIONMINUTES=60

# Thư mục lưu file local, tính tương đối từ thư mục chạy API.
FILESTORAGE__ROOTPATH=storage

# Cấu hình S3 dự phòng; chỉ điền khi chuyển provider từ local sang S3.
S3STORAGE__ENABLED=false
S3STORAGE__BUCKETNAME=your-bucket
S3STORAGE__REGION=us-east-1
S3STORAGE__SERVICEURL=
S3STORAGE__ACCESSKEY=your-access-key
S3STORAGE__SECRETKEY=your-secret-key
S3STORAGE__FORCEPATHSTYLE=false

# OAuth Google; tạo Web application OAuth client trong Google Cloud Console.
OAUTH__GOOGLE__CLIENTID=your-google-client-id
OAUTH__GOOGLE__CLIENTSECRET=your-google-client-secret
# Phải đăng ký URI này trong Authorized redirect URIs.
OAUTH__GOOGLE__REDIRECTURI=http://localhost:5258/api/auth/oauth/Google/callback